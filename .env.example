# --- Target portal (the mock portal by default) ---
PORTAL_BASE_URL=http://localhost:4010
PORTAL_USERNAME=demo-operator
PORTAL_PASSWORD=change-me-locally

# --- Mock portal ---
MOCK_PORTAL_PORT=4010

# --- Browser worker ---
# false = show the browser window while the worker fills the form
BROWSER_HEADLESS=true
# How long a filled form waits for approval before the browser is closed
APPROVAL_TTL_SECONDS=600

# --- LLM (optional: pre-fills the form from free text, writes the daily report) ---
# openrouter (default) or bedrock
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Bedrock uses AWS credentials instead of a key: the ECS task role on AWS, AWS_PROFILE on a laptop.
# The model must be invocable in BEDROCK_REGION (default: AWS_REGION).
BEDROCK_MODEL=zai.glm-4.7-flash
BEDROCK_REGION=

# --- Slack (Socket Mode: no public URL needed) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- Daily report (optional: /daily-report and the daily schedule) ---
# Channel IDs to read, comma-separated. Invite the bot to each one first.
REPORT_CHANNELS=
# Channel ID the report is posted to
REPORT_POST_CHANNEL=
# Local time HH:MM to post every day; empty = only on /daily-report. Set TZ for the timezone.
REPORT_TIME=
REPORT_LANGUAGE=Vietnamese
# Model for the report; empty = the provider's model above
REPORT_MODEL=

# --- Jira Cloud (optional: adds the progress check to the report) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Overrides the default query (open issues of the project plus those updated in the last day)
JIRA_JQL=

# --- Knowledge base chatbot (optional: /ask, mentions and direct messages) ---
# MCP URL of the knowledge base gateway, printed by `infra/kb.sh up`. Needs an LLM provider above.
# Requests are signed with AWS credentials that may call bedrock-agentcore:InvokeGateway.
KB_MCP_URL=
# Region of the gateway; empty = BEDROCK_REGION, then AWS_REGION
KB_REGION=
# Model that writes the answer; empty = the provider's model above
KB_MODEL=
# Passages fetched per question
KB_RESULTS=8

# --- Confluence Cloud (optional: publishes the sample pages with `npm run kb:confluence`) ---
# Empty = the Jira values above (same Atlassian site, same API token)
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=KBDEMO

# Log file of the Slack bot (JSON lines; default artifacts/logs/slack-bot.jsonl, ignored by git).
# It records each knowledge base question and answer, so keep it off shared machines.
#LOG_FILE=
