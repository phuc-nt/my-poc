{
  "Comment": "AIPF POC: one work item, from the Jira label to a merged pull request. Placeholders are CloudFormation DefinitionSubstitutions.",
  "QueryLanguage": "JSONata",
  "StartAt": "StartRun",
  "States": {
    "StartRun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${Orchestrator}",
        "Payload": "{% $merge([$states.input, {'action': 'startRun', 'runId': $states.context.Execution.Name}]) %}"
      },
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"], "MaxAttempts": 3 }],
      "Assign": { "run": "{% $states.result.Payload %}", "prId": "" },
      "Next": "Developer"
    },
    "Developer": {
      "Type": "Task",
      "Comment": "A developer session in a sandbox started from the repository snapshot.",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Arguments": {
        "Cluster": "${Cluster}",
        "TaskDefinition": "${TaskDefinition}",
        "LaunchType": "FARGATE",
        "PropagateTags": "TASK_DEFINITION",
        "EnableECSManagedTags": true,
        "NetworkConfiguration": {
          "AwsvpcConfiguration": { "Subnets": ["${SubnetA}", "${SubnetB}"], "SecurityGroups": ["${SandboxSecurityGroup}"], "AssignPublicIp": "ENABLED" }
        },
        "Overrides": {
          "TaskRoleArn": "${DeveloperRole}",
          "ContainerOverrides": [{
            "Name": "harness",
            "Environment": [
              { "Name": "AIPF_ROLE", "Value": "developer" },
              { "Name": "AIPF_HARNESS", "Value": "{% $run.harness %}" },
              { "Name": "AIPF_MODEL", "Value": "{% $run.model %}" },
              { "Name": "AIPF_ISSUE_KEY", "Value": "{% $run.issueKey %}" },
              { "Name": "AIPF_RUN_ID", "Value": "{% $run.runId %}" },
              { "Name": "AIPF_ATTEMPT", "Value": "{% $string($run.attempt) %}" },
              { "Name": "AIPF_PR_ID", "Value": "{% $prId ? $string($prId) : '' %}" }
            ]
          }]
        }
      },
      "TimeoutSeconds": 3600,
      "Output": {},
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": {}, "Next": "AfterDeveloper" }],
      "Next": "AfterDeveloper"
    },
    "AfterDeveloper": {
      "Type": "Task",
      "Comment": "What the session left: a question for a person, a pull request, or neither.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": { "FunctionName": "${Orchestrator}", "Payload": { "action": "afterDeveloper", "run": "{% $run %}" } },
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"], "MaxAttempts": 3 }],
      "Assign": { "outcome": "{% $states.result.Payload %}", "prId": "{% $states.result.Payload.prId %}" },
      "Next": "WhatHappened"
    },
    "WhatHappened": {
      "Type": "Choice",
      "Choices": [
        { "Condition": "{% $outcome.outcome = 'needs_human' %}", "Next": "AskHuman" },
        { "Condition": "{% $outcome.outcome = 'pr' %}", "Next": "CI" }
      ],
      "Default": "NoPullRequest"
    },
    "AskHuman": {
      "Type": "Task",
      "Comment": "Posts the question to Slack with a link to a form; waits for the answer.",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Arguments": {
        "FunctionName": "${Orchestrator}",
        "Payload": { "action": "askHuman", "token": "{% $states.context.Task.Token %}", "run": "{% $run %}", "question": "{% $outcome.question %}" }
      },
      "TimeoutSeconds": 259200,
      "Catch": [{ "ErrorEquals": ["States.Timeout"], "Assign": { "reason": "nobody answered the developer agent's question within 3 days" }, "Next": "Escalate" }],
      "Next": "Answered"
    },
    "Answered": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${Orchestrator}",
        "Payload": { "action": "nextAttempt", "run": "{% $run %}", "reason": "answer", "detail": { "question": "{% $outcome.question %}", "answer": "{% $states.input.answer %}" } }
      },
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"], "MaxAttempts": 3 }],
      "Assign": { "run": "{% $states.result.Payload %}" },
      "Next": "Developer"
    },
    "NoPullRequest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${Orchestrator}",
        "Payload": { "action": "nextAttempt", "run": "{% $run %}", "reason": "no_pr", "detail": "{% $outcome.detail %}" }
      },
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"], "MaxAttempts": 3 }],
      "Assign": { "run": "{% $states.result.Payload %}" },
      "Next": "AttemptsLeft"
    },
    "CI": {
      "Type": "Task",
      "Comment": "The repository's own CI (buildspec.yml) on the agent's branch.",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Arguments": { "ProjectName": "${CiProject}", "SourceVersion": "{% 'refs/heads/' & $run.branch %}" },
      "TimeoutSeconds": 3600,
      "Output": {},
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": "{% $states.errorOutput %}", "Next": "CIFailed" }],
      "Next": "Reviewer"
    },
    "CIFailed": {
      "Type": "Task",
      "Comment": "Posts the end of the CI log on the pull request and gives it to the next developer session.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${Orchestrator}",
        "Payload": { "action": "ciFailed", "run": "{% $run %}", "prId": "{% $prId %}", "error": "{% $states.input %}" }
      },
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"], "MaxAttempts": 3 }],
      "Assign": { "run": "{% $states.result.Payload %}" },
      "Next": "AttemptsLeft"
    },
    "Reviewer": {
      "Type": "Task",
      "Comment": "A reviewer session; it comments on the pull request. A failed review does not stop the flow, a person reviews anyway.",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Arguments": {
        "Cluster": "${Cluster}",
        "TaskDefinition": "${TaskDefinition}",
        "LaunchType": "FARGATE",
        "PropagateTags": "TASK_DEFINITION",
        "EnableECSManagedTags": true,
        "NetworkConfiguration": {
          "AwsvpcConfiguration": { "Subnets": ["${SubnetA}", "${SubnetB}"], "SecurityGroups": ["${SandboxSecurityGroup}"], "AssignPublicIp": "ENABLED" }
        },
        "Overrides": {
          "TaskRoleArn": "${ReviewerRole}",
          "ContainerOverrides": [{
            "Name": "harness",
            "Environment": [
              { "Name": "AIPF_ROLE", "Value": "reviewer" },
              { "Name": "AIPF_HARNESS", "Value": "{% $run.harness %}" },
              { "Name": "AIPF_MODEL", "Value": "{% $run.model %}" },
              { "Name": "AIPF_ISSUE_KEY", "Value": "{% $run.issueKey %}" },
              { "Name": "AIPF_RUN_ID", "Value": "{% $run.runId %}" },
              { "Name": "AIPF_ATTEMPT", "Value": "{% $string($run.attempt) %}" },
              { "Name": "AIPF_PR_ID", "Value": "{% $string($prId) %}" }
            ]
          }]
        }
      },
      "TimeoutSeconds": 3600,
      "Output": {},
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Output": {}, "Next": "RequestApproval" }],
      "Next": "RequestApproval"
    },
    "RequestApproval": {
      "Type": "Task",
      "Comment": "Asks a person in Slack to review; resumes when the pull request is merged or closed, or the person asks for changes.",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Arguments": {
        "FunctionName": "${Orchestrator}",
        "Payload": { "action": "requestApproval", "token": "{% $states.context.Task.Token %}", "run": "{% $run %}", "prId": "{% $prId %}" }
      },
      "TimeoutSeconds": 604800,
      "Catch": [{ "ErrorEquals": ["States.Timeout"], "Assign": { "reason": "nobody reviewed the pull request within 7 days" }, "Next": "Escalate" }],
      "Next": "Decision"
    },
    "Decision": {
      "Type": "Choice",
      "Choices": [
        { "Condition": "{% $states.input.decision = 'merged' %}", "Next": "Done" },
        { "Condition": "{% $states.input.decision = 'changes' %}", "Next": "ChangesRequested" }
      ],
      "Default": "Closed"
    },
    "ChangesRequested": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${Orchestrator}",
        "Payload": { "action": "nextAttempt", "run": "{% $run %}", "reason": "changes", "detail": "{% $states.input.feedback %}" }
      },
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"], "MaxAttempts": 3 }],
      "Assign": { "run": "{% $states.result.Payload %}" },
      "Next": "AttemptsLeft"
    },
    "AttemptsLeft": {
      "Type": "Choice",
      "Choices": [{ "Condition": "{% $run.exhausted %}", "Next": "OutOfAttempts" }],
      "Default": "Developer"
    },
    "OutOfAttempts": {
      "Type": "Pass",
      "Assign": { "reason": "{% 'the work did not reach an accepted pull request after ' & $string($run.failures) & ' failed attempts (last: ' & $run.lastReason & ')' %}" },
      "Next": "Escalate"
    },
    "Closed": {
      "Type": "Pass",
      "Assign": { "reason": "the pull request was closed without merging" },
      "Next": "Escalate"
    },
    "Escalate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": { "FunctionName": "${Orchestrator}", "Payload": { "action": "escalate", "run": "{% $run %}", "reason": "{% $reason %}" } },
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"], "MaxAttempts": 3 }],
      "Next": "Escalated"
    },
    "Escalated": { "Type": "Fail", "Error": "Escalated", "Cause": "A person needs to take over; see Slack and the work item." },
    "Done": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": { "FunctionName": "${Orchestrator}", "Payload": { "action": "done", "run": "{% $run %}", "prId": "{% $prId %}" } },
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"], "MaxAttempts": 3 }],
      "Next": "Finished"
    },
    "Finished": { "Type": "Succeed" }
  }
}
