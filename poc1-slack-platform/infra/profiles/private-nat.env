# Target architecture: task in a private subnet, all outbound traffic through one NAT Gateway
# with an Elastic IP, so the web app owner can allowlist a single address.
# About 82 USD/month when left running at one Region's list prices (docs/04-operating-cost.md).
NETWORK_PROFILE=private-nat
CPU=1024
MEMORY=2048
BEDROCK_MODEL=zai.glm-4.7-flash
# IANA name of the time zone the reports and the schedule use
TIME_ZONE=UTC
# HH:MM in TIME_ZONE to post the daily report every day; empty = only on /daily-report
REPORT_TIME=
