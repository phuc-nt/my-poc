# Cheapest setup: task in a public subnet with its own public IP. No NAT Gateway and no fixed
# outbound IP, so it cannot be used with a web app that allowlists addresses.
# About 39 USD/month when left running at one Region's list prices (docs/04-operating-cost.md).
NETWORK_PROFILE=public
CPU=1024
MEMORY=2048
BEDROCK_MODEL=zai.glm-4.7-flash
# IANA name of the time zone the reports and the schedule use
TIME_ZONE=UTC
REPORT_TIME=
