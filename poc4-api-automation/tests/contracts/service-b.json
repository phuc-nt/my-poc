          "data": {
            "$ref": "#/components/schemas/Ownership"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "SubscriptionRequest": {
        "required": [
          "plan"
        ],
        "type": "object",
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "BASIC",
              "PREMIUM"
            ]
          }
        }
      },
      "RestApiResponseSubscription": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "enum": [
              "OK",
              "NG"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/Subscription"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Subscription": {
        "type": "object",
        "properties": {
          "subscriptionId": {
            "type": "string"
          },
          "ownershipId": {
            "type": "string"
          },
          "plan": {
            "type": "string",
            "enum": [
              "BASIC",
              "PREMIUM"
            ]
          },
          "status": {
            "type": "string"
          },
          "paymentRef": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RestApiResponseVinOwner": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
