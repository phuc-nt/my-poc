  "components": {
    "schemas": {
      "VinCallback": {
        "required": [
          "executionId",
          "result",
          "vin"
        ],
        "type": "object",
        "properties": {
          "executionId": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string"
          },
          "vin": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "reason": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "messageId": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "field": {
            "type": "string"
          }
        }
      },
      "RestApiResponseVinRegistration": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "enum": [
              "OK",
              "NG"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/VinRegistration"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "VinRegistration": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string"
          },
          "modelCode": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "executionId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SimStatusCallback": {
        "required": [
          "iccid",
          "status"
        ],
        "type": "object",
        "properties": {
          "iccid": {
            "pattern": "^\\d{19,20}$",
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "FAILED",
              "INACTIVE"
            ]
          }
        }
      },
      "RestApiResponseTcu": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "enum": [
              "OK",
              "NG"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/Tcu"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Tcu": {
        "type": "object",
        "properties": {
          "tcuId": {
            "type": "string"
          },
          "vin": {
            "type": "string"
          },
          "iccid": {
            "type": "string"
          },
          "simStatus": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "VinRegistrationRequest": {
        "required": [
          "modelCode",
          "vin"
        ],
        "type": "object",
        "properties": {
          "vin": {
            "type": "string"
          },
          "modelCode": {
            "pattern": "^[A-Z0-9]{3,10}$",
            "type": "string"
          }
        }
      },
      "CreateOwnershipRequest": {
        "required": [
          "vin"
        ],
        "type": "object",
        "properties": {
          "vin": {
            "type": "string"
          },
          "nickname": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "Ownership": {
        "type": "object",
        "properties": {
          "ownershipId": {
            "type": "string"
          },
          "vin": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RestApiResponseOwnership": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "enum": [
              "OK",
              "NG"
            ]
