              "$ref": "#/components/schemas/Ownership"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "RestApiResponseListSubscription": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "enum": [
              "OK",
              "NG"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Subscription"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
