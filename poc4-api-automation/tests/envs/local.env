# Dummy values for the local simulation only (they match compose.yaml). Real environments never use this file:
# their secrets come from the pipeline's secret store or an uncommitted envs/<name>.env.
PW_USER_PASSWORD=local-only-password
PW_BO_CLIENT_SECRET=local-only-secret
PW_INTERNAL_API_KEY=local-only-internal-key
PW_PARTNER_API_KEY=local-only-partner-key
