{
  "name": "poc4-api-tests",
  "private": true,
  "description": "API automation for the two REST services, on Playwright Test",
  "scripts": {
    "test": "playwright test",
    "smoke": "playwright test --grep @smoke",
    "contract": "playwright test --grep @contract",
    "framework": "PW_ONLY_FRAMEWORK=1 playwright test --grep @framework",
    "typecheck": "tsc --noEmit",
    "contracts:update": "node scripts/update-contracts.mjs",
    "report": "playwright show-report results/html"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  }
}
