# Copy to .env (ignored by git) and fill in. Only the key name is shown here.
ANTHROPIC_API_KEY=
# Stop billed runs when the cost logged in runs/ reaches this many US dollars.
SPEC_REVIEW_BUDGET_USD=30
# P5: the MCP server's stand-in credential. .mcp.json reads it as ${SPEC_SERVER_TOKEN}; export it in the shell
# before starting Claude Code (any non-empty value; a real server would hold its upstream API token here).
SPEC_SERVER_TOKEN=
